/* 全局基础样式：卡片 / 按钮 / 标签 */
page {
  background: #f5f5f5;
  color: #1f2430;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  padding: 24rpx 24rpx 180rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: #8b93a1;
  font-size: 24rpx;
}

.mono {
  font-family: "DIN Alternate", Menlo, Consolas, monospace;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin: 8rpx 0 16rpx;
}

.divider {
  height: 1rpx;
  background: #eef0f4;
  margin: 16rpx 0;
}

.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #f0f2f6;
  color: #5c6472;
}

.tag--warn { background: #fff4e5; color: #b26a00; }
.tag--info { background: #e8f1ff; color: #2361d8; }
.tag--success { background: #e7f7ee; color: #1a7f4b; }
.tag--danger { background: #ffecec; color: #c62828; }
.tag--muted { background: #f0f2f6; color: #8b93a1; }

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #f0f2f6;
  color: #1f2430;
  line-height: 1;
}

.btn::after { border: none; }

.btn--primary {
  background: #e85d04;
  color: #ffffff;
}

.btn--ghost {
  background: #ffffff;
  border: 1rpx solid #e3e6ec;
}

.btn--small {
  height: 60rpx;
  padding: 0 22rpx;
  font-size: 24rpx;
}

.btn--block {
  display: flex;
  width: 100%;
}

.btn--disabled {
  opacity: 0.45;
}

.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #8b93a1;
}

.empty-title {
  font-size: 30rpx;
  color: #5c6472;
  margin-bottom: 12rpx;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f2f6;
}

.cell:last-child { border-bottom: none; }

.cell-label { color: #5c6472; }
.cell-value { color: #1f2430; text-align: right; }

.safe-bottom { padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }

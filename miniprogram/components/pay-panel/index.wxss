.pay-panel {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.pay-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.pay-title {
  font-size: 30rpx;
  font-weight: 600;
}

.pay-amount {
  font-size: 36rpx;
  font-weight: 600;
  color: #e85d04;
}

.pay-qr {
  width: 380rpx;
  height: 380rpx;
  display: block;
  margin: 0 auto 16rpx;
  background: #f4f5f8;
  border-radius: 12rpx;
}

.pay-qr-empty {
  font-size: 24rpx;
  color: #8b93a1;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 40rpx 24rpx;
  text-align: center;
  margin-bottom: 16rpx;
}

.pay-payee {
  font-size: 24rpx;
  color: #5c6472;
  text-align: center;
  margin-bottom: 8rpx;
}

.pay-tip {
  font-size: 24rpx;
  color: #8b93a1;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.pay-btn {
  height: 88rpx;
  border-radius: 999rpx;
}

.pay-error {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #c62828;
  line-height: 1.6;
}

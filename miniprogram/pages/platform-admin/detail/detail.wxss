.page { padding: 16px; }
.tip { color: #666; font-size: 13px; margin: 8px 0; }
.hint { color: #8a6d3b; line-height: 1.6; word-break: break-all; }
.error { color: #c62828; font-size: 13px; margin: 8px 0; word-break: break-all; }
.card { background: #fff; border-radius: 10px; padding: 12px; margin: 10px 0; box-shadow: 0 1px 3px rgba(0,0,0,.06); }
.card-title { font-size: 15px; font-weight: 600; margin-bottom: 8px; }
.input { border: 1px solid #e0e0e0; border-radius: 8px; padding: 8px 10px; margin: 6px 0; font-size: 14px; background: #fff; }
.btn { margin: 8px 0; font-size: 14px; border-radius: 8px; background: #f2f3f5; }
.btn.primary { background: #1677ff; color: #fff; }
.btn.small { margin: 0; padding: 4px 12px; font-size: 13px; line-height: 1.8; }
.row { display: flex; justify-content: space-between; align-items: center; }
.row.small { font-size: 12px; padding: 4px 0; border-bottom: 1px solid #f5f5f5; }
.name { font-size: 15px; font-weight: 600; }
.tag { font-size: 12px; padding: 1px 8px; border-radius: 10px; }
.tag.on { background: #f6ffed; color: #389e0d; }
.tag.off { background: #fff1f0; color: #cf1322; }
.meta { color: #888; font-size: 12px; margin-top: 4px; word-break: break-all; }
.actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
.staff-row { font-size: 12px; padding: 6px 0; border-bottom: 1px solid #f0f0f0; word-break: break-all; }
.ok { color: #389e0d; }
.bad { color: #cf1322; }

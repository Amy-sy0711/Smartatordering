.identity-card {
  border-left: 8rpx solid #e85d04;
}

.identity-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.identity-label {
  font-size: 28rpx;
  font-weight: 600;
}

.copy {
  font-size: 24rpx;
  color: #e85d04;
  text-decoration: underline;
}

.identity-value {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #1f2430;
  word-break: break-all;
  background: #f7f8fa;
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
}

.identity-role {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #5c6472;
}

.claim-btn {
  margin-top: 20rpx;
}

.identity-note {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8b93a1;
  line-height: 1.5;
}

.diagnose-page {
  padding-bottom: 60rpx;
}

.diagnose-head .title {
  margin-bottom: 8rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.tag-row .tag {
  margin: 0 12rpx 10rpx 0;
}

.summary {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.summary--ok {
  background: #e7f7ee;
  color: #1a7f4b;
}

.summary--fail {
  background: #ffecec;
  color: #c62828;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.action-btn {
  margin: 0 16rpx 12rpx 0;
}

.check-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.check-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.check-detail {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #5c6472;
  line-height: 1.6;
  word-break: break-all;
}

.check-fix {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #b26a00;
  line-height: 1.6;
  background: #fff8ec;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  word-break: break-all;
}

.actions-card {
  margin-top: 10rpx;
}

.action-row {
  margin-bottom: 16rpx;
}

.action-row:last-child {
  margin-bottom: 0;
}

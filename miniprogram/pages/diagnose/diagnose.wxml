<view class="page diagnose-page">
  <view class="card diagnose-head">
    <view class="title">环境自检</view>
    <view class="muted">逐项检查云开发环境、云函数、数据库集合与今日菜单</view>
    <view class="tag-row">
      <text class="tag tag--info">模式：{{modeLabel}}</text>
      <text class="tag tag--muted">CLOUD_ENV：{{cloudEnv || '空'}}</text>
    </view>
    <view class="summary {{failCount ? 'summary--fail' : 'summary--ok'}}">{{summaryText || '检查中…'}}</view>
    <view class="actions">
      <button class="btn btn--primary btn--small action-btn" bindtap="run" loading="{{running}}">重新自检</button>
      <button class="btn btn--ghost btn--small action-btn" bindtap="copyReport">复制报告</button>
    </view>
  </view>

  <view class="card identity-card" wx:if="{{openid}}">
    <view class="identity-head">
      <view class="identity-label">我的 openid</view>
      <text class="copy" bindtap="copyOpenid">复制</text>
    </view>
    <view class="mono identity-value" selectable>{{openid}}</view>
    <view class="identity-role">角色：{{isAdmin ? '平台管理员' : (isMerchant ? '商家' : '顾客')}}</view>
  </view>

  <view class="card check" wx:for="{{checks}}" wx:key="key">
    <view class="check-head">
      <view class="check-title">{{item.title}}</view>
      <text class="tag {{item.status === 'pass' ? 'tag--success' : (item.status === 'fail' ? 'tag--danger' : 'tag--warn')}}">{{item.statusText}}</text>
    </view>
    <view class="check-detail" selectable>{{item.detail}}</view>
    <view class="check-fix" wx:if="{{item.fix}}" selectable>修复：{{item.fix}}</view>
  </view>

  <view class="card actions-card">
    <button class="btn btn--block action-row" bindtap="goHome">返回首页</button>
  </view>
</view>

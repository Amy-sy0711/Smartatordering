.menu-page {
  padding-bottom: 220rpx;
}

.local-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff3e0;
  border: 1rpx solid #ffb74d;
  color: #8a4b00;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
}
.local-banner-title {
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.local-banner-desc {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.4;
}
.local-banner-link {
  color: #e85d04;
  font-size: 24rpx;
  flex-shrink: 0;
}

.preview-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #e8f0fe;
  border: 1rpx solid #a9c7ff;
  color: #1a4fa0;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
}
.preview-link {
  color: #1a4fa0;
  font-weight: 600;
}

.hero {
  background: linear-gradient(135deg, #ff8c42, #e85d04);
  color: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.hero-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 600;
}

.hero-date {
  font-size: 24rpx;
  opacity: 0.85;
}

.hero-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 10rpx;
}

.hero-slots {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.slot-chip {
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  margin: 0 12rpx 10rpx 0;
}

.slot-chip--full {
  opacity: 0.5;
}

.slot-left {
  margin-left: 8rpx;
  opacity: 0.9;
}

.pay-hint {
  display: flex;
  flex-direction: column;
}

.pay-hint-mode {
  font-size: 24rpx;
  color: #e85d04;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.pay-hint-text {
  font-size: 24rpx;
  color: #8b93a1;
  line-height: 1.5;
}

.loading {
  padding: 100rpx 0;
  text-align: center;
  color: #8b93a1;
}

.empty-btn {
  margin-top: 0;
  width: 260rpx;
}

.empty-sub {
  margin-top: 10rpx;
}

.empty-link {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #8b93a1;
  text-decoration: underline;
}

.identity-banner {
  background: #fff4e5;
  border: 1rpx solid #ffd6a3;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 18rpx;
}

.identity-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #b26a00;
}

.identity-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a5a12;
  line-height: 1.5;
  word-break: break-all;
}

.state-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.state-card--fail {
  border-left: 8rpx solid #e85d04;
}

.state-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2430;
  margin-bottom: 12rpx;
}

.state-desc {
  font-size: 24rpx;
  color: #5c6472;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.state-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 10rpx;
}

.state-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #8b93a1;
}

.state-value {
  flex: 1;
  font-size: 22rpx;
  color: #1f2430;
  word-break: break-all;
}

.state-actions {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.state-btn {
  width: 200rpx;
  margin: 0 16rpx 12rpx 0;
  font-size: 24rpx;
  padding: 0;
  height: 64rpx;
  line-height: 64rpx;
}

.menu-body {
  display: flex;
  align-items: flex-start;
}

/* 左栏固定约 88px（176rpx），分类多时可纵向滚动 */
.cat-rail {
  width: 176rpx;
  flex-shrink: 0;
  background: #f5f6f9;
  border-radius: 16rpx;
  overflow: hidden;
}

.cat-rail-item {
  position: relative;
  padding: 24rpx 12rpx;
  font-size: 24rpx;
  color: #5c6472;
  line-height: 1.35;
  text-align: center;
  word-break: break-all;
}

.cat-rail-item--active {
  background: #ffffff;
  color: #e85d04;
  font-weight: 700;
}

.cat-rail-item--active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  width: 6rpx;
  height: 40rpx;
  margin-top: -20rpx;
  background: #e85d04;
  border-radius: 0 6rpx 6rpx 0;
}

.dish-scroll {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.dish-scroll--full {
  margin-left: 0;
}

.dish-scroll-tail {
  width: 100%;
}

.cat {
  margin-bottom: 24rpx;
}

.cat-title {
  font-size: 26rpx;
  color: #5c6472;
  font-weight: 600;
  margin: 12rpx 0 14rpx;
  padding-left: 8rpx;
}

.dish {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.dish--soldout {
  opacity: 0.55;
}

.dish-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 14rpx;
  background: #f2f4f8;
  flex-shrink: 0;
}

.dish-img--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b8bec9;
  font-size: 44rpx;
}

.dish-body {
  flex: 1;
  margin-left: 20rpx;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
}

.dish-spec {
  font-size: 22rpx;
  color: #8b93a1;
  margin-top: 6rpx;
}

.dish-price {
  color: #e85d04;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 10rpx;
}

.dish-add {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 50%;
  background: #fff1e5;
  color: #e85d04;
  font-size: 34rpx;
}

.dish-sold {
  font-size: 24rpx;
  color: #8b93a1;
  padding: 6rpx 16rpx;
  background: #f2f4f8;
  border-radius: 999rpx;
}

.footer-links {
  display: flex;
  justify-content: center;
  padding: 20rpx 0 10rpx;
}

.footer-link {
  font-size: 24rpx;
  color: #8b93a1;
  margin: 0 24rpx;
  text-decoration: underline;
}

.footer-link--demo {
  color: #b26a00;
}

.footer-link--merchant {
  color: #e85d04;
  font-weight: 600;
}

.mode-note {
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 22rpx;
  color: #8b93a1;
  padding-bottom: 12rpx;
}

.mode-link {
  color: #e85d04;
  margin-left: 12rpx;
  text-decoration: underline;
}

.cartbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #1f2430;
  color: #ffffff;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 14rpx 14rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
}

.cartbar-left {
  display: flex;
  align-items: center;
}

.cartbar-icon {
  font-size: 30rpx;
  margin-right: 12rpx;
}

.cartbar-count {
  font-size: 24rpx;
  opacity: 0.8;
  margin-right: 16rpx;
}

.cartbar-total {
  font-size: 32rpx;
  font-weight: 600;
}

.cartbar-btn {
  height: 72rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  background: #e85d04;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 72rpx;
}

.cartbar-btn--disabled {
  background: #4a505c;
  color: #a7adba;
}

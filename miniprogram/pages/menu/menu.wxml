<view class="page menu-page">
  <view class="local-banner" wx:if="{{isLocal}}">
    <view class="local-banner-title">本地演示模式</view>
    <view class="local-banner-desc">数据不会同步到云端，其他人看不到。切换模式请修改开发配置。</view>
  </view>

  <view class="preview-banner" wx:if="{{fromMerchant}}">
    <text class="preview-text">商家预览中 · 当前为顾客视角</text>
    <text class="preview-link" bindtap="backToBoard">返回看板 →</text>
  </view>

  <view class="identity-banner" wx:if="{{identityError}}">
    <view class="identity-title">身份校验失败</view>
    <view class="identity-desc">{{identityError.message || '请稍后重试，持续失败请联系管理员'}}</view>
  </view>

  <view class="hero" wx:if="{{published}}">
    <view class="hero-top">
      <text class="hero-title">{{menu.title}}</text>
      <text class="hero-date">{{dateLabel}}</text>
    </view>
    <view class="hero-sub" wx:if="{{shop}}">{{shop.pickupPlace}} · {{shop.pickupNote}}</view>
    <view class="hero-slots">
      <view class="slot-chip {{slot.full ? 'slot-chip--full' : ''}}" wx:for="{{slots}}" wx:key="id">
        {{slot.label}}
        <text class="slot-left">{{slot.leftText}}</text>
      </view>
    </view>
  </view>

  <view class="card pay-hint" wx:if="{{published}}">
    <text class="pay-hint-mode">{{paySettings.payModeLabel}}</text>
    <text class="pay-hint-text">{{paySettings.payMode === 'transfer' ? paySettings.transfer.tipText : (paySettings.payMode === 'jsapi' ? '下单后直接在小程序内微信支付' : '开发调试：下单后模拟支付')}}</text>
  </view>

  <view class="loading" wx:if="{{loadState === 'loading'}}">菜单加载中…</view>

  <view class="state-card state-card--fail" wx:elif="{{loadState === 'load_failed'}}">
    <view class="state-title">{{fromMerchant ? '系统暂时不可用' : '云端未连通'}}</view>
    <view class="state-desc">{{errorHint}}</view>
    <view class="state-row" wx:if="{{errorCode}}">
      <text class="state-label">错误码</text>
      <text class="state-value" selectable>{{errorCode}}</text>
    </view>
    <view class="state-row" wx:if="{{errorMsg}}">
      <text class="state-label">错误信息</text>
      <text class="state-value" selectable>{{errorMsg}}</text>
    </view>
    <view class="state-actions">
      <button class="btn btn--ghost state-btn" bindtap="retry">重试</button>
      <button class="btn btn--ghost state-btn" wx:if="{{errorCode}}" bindtap="copyError">复制错误</button>
    </view>
  </view>

  <view class="empty" wx:elif="{{loadState === 'empty'}}">
    <view class="empty-title">商家尚未发布今日菜单</view>
    <view class="empty-sub">发布后下拉刷新即可点餐</view>
    <view class="state-actions">
      <button class="btn btn--ghost empty-btn" bindtap="retry">刷新试试</button>
    </view>
  </view>

  <block wx:if="{{loadState === 'ready'}}">
    <view class="cat" wx:for="{{categories}}" wx:key="name" wx:for-item="cat">
      <view class="cat-title">{{cat.name}}</view>
      <view
        class="dish {{dish.soldOut ? 'dish--soldout' : ''}}"
        wx:for="{{cat.dishes}}"
        wx:key="_id"
        wx:for-item="dish"
        data-id="{{dish._id}}"
        bindtap="onDishTap"
      >
        <image class="dish-img" wx:if="{{dish.imageUrl}}" src="{{dish.imageUrl}}" mode="aspectFill"></image>
        <view class="dish-img dish-img--ph" wx:else>{{dish.initial}}</view>
        <view class="dish-body">
          <view class="dish-name">{{dish.name}}</view>
          <view class="dish-spec" wx:if="{{dish.specs.length}}">可选规格 {{dish.specs.length}} 组</view>
          <view class="dish-price">¥{{dish.priceText}}</view>
        </view>
        <view class="dish-add" wx:if="{{!dish.soldOut}}">＋</view>
        <view class="dish-sold" wx:else>售罄</view>
      </view>
    </view>
  </block>

  <!-- 顾客端不提供任何进入商家端的入口；商家身份由启动 whoami 自动识别 -->
  <view class="footer-links">
    <text class="footer-link" bindtap="goOrders">我的订单</text>
  </view>
  <view class="mode-note">
    <text>当前：{{modeLabel || '云端模式'}}</text>
  </view>

  <view class="cartbar" wx:if="{{published}}">
    <view class="cartbar-left" bindtap="goOrders">
      <text class="cartbar-icon">🧺</text>
      <text class="cartbar-count">{{cartCount}} 件</text>
      <text class="cartbar-total">¥{{cartTotalText}}</text>
    </view>
    <view class="cartbar-btn {{cartCount ? '' : 'cartbar-btn--disabled'}}" bindtap="goCart">去结算</view>
  </view>

  <spec-picker
    wx:if="{{pickerVisible}}"
    dish="{{pickerDish}}"
    bind:close="onPickerClose"
    bind:confirm="onPickerConfirm"
  />
</view>

<view class="page">
  <merchant-exit />
  <view class="board-head">
    <view class="title">订单看板</view>
    <view class="muted">{{dateLabel}} · 按时间倒序 · 下拉刷新</view>
  </view>

  <scroll-view class="tabs" scroll-x="true" enable-flex="true">
    <view
      class="tab {{activeKey === item.key ? 'tab--active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="switchTab"
    >
      {{item.label}}
      <text class="tab-count" wx:if="{{item.count}}">{{item.count}}</text>
    </view>
  </scroll-view>

  <view class="loading" wx:if="{{loading}}">加载订单…</view>
  <view class="empty" wx:elif="{{!list.length}}">
    <view class="empty-title">暂无订单</view>
    <view>切换上方状态筛选，或等顾客下单后再来</view>
  </view>

  <view class="card order-card" wx:for="{{list}}" wx:key="orderId" data-id="{{item.orderId}}" bindtap="openOrder">
    <view class="row-between">
      <view class="order-no">#{{item.orderNo}}</view>
      <text class="tag {{item.statusTag}}">{{item.statusText}}</text>
    </view>
    <view class="muted order-time">{{item.createdAtText}} · {{item.slotLabel}} · {{item.payChannelLabel}}</view>
    <view class="order-stale" wx:if="{{item.isStale}}">非今日订单（{{item.date}}）待收款</view>

    <view class="order-items">{{item.itemSummary}}</view>
    <view class="order-remark" wx:if="{{item.remark}}">备注：{{item.remark}}</view>
    <view class="order-transfer" wx:if="{{item.needConfirmReceipt}}">
      <text wx:if="{{item.status === 'pending_confirm'}}">顾客已标记转账</text>
      <text wx:else>顾客待支付（群转账），确认到账后点「确认收款」</text>{{item.transferNote ? '：' + item.transferNote : ''}}{{item.transferredAtText ? '（' + item.transferredAtText + '）' : ''}}
    </view>
    <view class="order-pickup" wx:if="{{item.pickupCode}}">
      取餐码 <text class="order-pickup-code">{{item.pickupCode}}</text>
    </view>

    <view class="order-foot">
      <view class="order-total">¥{{item.totalText}}</view>
      <view class="order-ops">
        <view
          class="btn btn--primary btn--small"
          wx:if="{{item.needConfirmReceipt}}"
          data-id="{{item.orderId}}"
          data-action="confirm"
          catchtap="doAction"
        >确认收款</view>
        <!-- 已收款即可出餐；accepted 仅兼容历史订单，新流程不再产生 -->
        <view
          class="btn btn--primary btn--small"
          wx:elif="{{item.status === 'paid' || item.status === 'accepted'}}"
          data-id="{{item.orderId}}"
          data-action="ready"
          catchtap="doAction"
        >出餐（生成取餐码）</view>
        <view
          class="btn btn--primary btn--small"
          wx:elif="{{item.status === 'ready'}}"
          data-id="{{item.orderId}}"
          data-action="complete"
          catchtap="doAction"
        >已取餐</view>
        <view
          class="btn btn--ghost btn--small"
          wx:if="{{item.canCancel}}"
          data-id="{{item.orderId}}"
          data-action="cancel"
          catchtap="doAction"
        >取消</view>
      </view>
    </view>
  </view>
</view>

.menu-date {
  margin-top: 6rpx;
}

.slots-line {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.slot-text {
  font-size: 22rpx;
  color: #5c6472;
  background: #f4f5f8;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  margin: 6rpx 10rpx 0 0;
}

.menu-count {
  margin-top: 10rpx;
}

.menu-actions {
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.menu-actions .btn {
  margin: 0 16rpx 12rpx 0;
}

.field {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.field-label {
  width: 160rpx;
  font-size: 26rpx;
  color: #5c6472;
}

.field-input {
  flex: 1;
  background: #f7f8fa;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
}

.field-title {
  font-size: 26rpx;
  color: #5c6472;
  margin: 16rpx 0 12rpx;
}

.slot-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.slot-input {
  flex: 1;
  background: #f7f8fa;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
}

.slot-limit {
  width: 130rpx;
  background: #f7f8fa;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  margin-left: 12rpx;
  text-align: center;
}

.slot-del {
  font-size: 22rpx;
  color: #c62828;
  margin-left: 12rpx;
}

.slot-add {
  margin-top: 6rpx;
}

.publish-hint {
  margin: 14rpx 0;
  line-height: 1.5;
}

.publish-btn {
  height: 84rpx;
  border-radius: 999rpx;
}

.history-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2f4f8;
}

.history-main {
  flex: 1;
}

.history-date {
  font-size: 26rpx;
  font-weight: 600;
}

.dish-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid #f2f4f8;
}

.dish-main {
  flex: 1;
}

.dish-name {
  font-size: 28rpx;
  font-weight: 600;
}

.dish-price {
  margin-top: 6rpx;
}

.dish-switches {
  display: flex;
  margin-top: 10rpx;
}

.switch-item {
  display: flex;
  align-items: center;
  margin-right: 30rpx;
  font-size: 22rpx;
  color: #5c6472;
}

.dish-ops {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-end;
}

.op {
  font-size: 24rpx;
  color: #2361d8;
  padding: 8rpx 0;
}

.op-danger {
  color: #c62828;
}

.empty {
  padding: 40rpx 0;
}

.small {
  padding: 24rpx 0;
}

.loading {
  padding: 100rpx 0;
  text-align: center;
  color: #8b93a1;
}

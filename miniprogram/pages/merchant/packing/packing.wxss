.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #8b93a1;
}

.summary-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.summary-nums {
  display: flex;
}

.summary-item {
  flex: 1;
  text-align: center;
}

.summary-value {
  font-size: 34rpx;
  font-weight: 600;
  color: #e85d04;
}

.summary-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8b93a1;
}

.summary-tip {
  margin-top: 18rpx;
  line-height: 1.5;
}

.summary-ops {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.text-box {
  padding: 18rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
  font-family: Menlo, Consolas, monospace;
}

.group-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f2f6;
}

.group-row:last-child {
  border-bottom: none;
}

.group-name {
  font-size: 28rpx;
}

.group-spec {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: #8b93a1;
}

.group-qty {
  font-size: 30rpx;
  font-weight: 600;
  color: #e85d04;
}

.pack-order {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f2f6;
}

.pack-order:last-child {
  border-bottom: none;
}

.pack-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pack-no {
  font-size: 28rpx;
  font-weight: 600;
}

.pack-check {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #5c6472;
}

.pack-check checkbox {
  transform: scale(0.8);
  margin-right: 4rpx;
}

.pack-items {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.pack-item {
  margin-right: 20rpx;
  font-size: 24rpx;
  color: #5c6472;
  line-height: 1.7;
}

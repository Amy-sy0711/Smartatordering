.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #8b93a1;
}

.mode-row {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 12rpx;
  border-radius: 14rpx;
  border: 1rpx solid #eef0f4;
  background: #fafbfc;
}

.mode-row--active {
  border-color: #e85d04;
  background: #fff8f2;
}

.mode-main {
  flex: 1;
}

.mode-label {
  font-size: 28rpx;
  font-weight: 600;
}

.mode-desc {
  margin-top: 6rpx;
  line-height: 1.5;
}

.radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #d5d9e0;
}

.radio--on {
  border-color: #e85d04;
  background: #e85d04;
}

.warn-box {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 10rpx;
  background: #fff4e5;
  color: #b26a00;
  font-size: 24rpx;
  line-height: 1.5;
}

.jsapi-note {
  margin-top: 14rpx;
}

.field {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f6;
}

.field--block {
  display: block;
}

.field-label {
  width: 200rpx;
  color: #5c6472;
  font-size: 26rpx;
}

.field--block .field-label {
  display: block;
  width: auto;
  margin-bottom: 12rpx;
}

.field-input {
  flex: 1;
  font-size: 28rpx;
}

.field-textarea {
  width: 100%;
  height: 140rpx;
  padding: 16rpx;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 10rpx;
  font-size: 26rpx;
}

.qr-line {
  display: flex;
  align-items: center;
  padding-top: 20rpx;
}

.qr-image {
  width: 180rpx;
  height: 180rpx;
  margin-right: 20rpx;
  border-radius: 12rpx;
  background: #f0f2f6;
}

.qr-empty {
  width: 180rpx;
  height: 180rpx;
  margin-right: 20rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  color: #8b93a1;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0 12rpx;
  box-sizing: border-box;
}

.qr-ops {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.qr-tip {
  margin-top: 12rpx;
}

.jsapi-steps {
  line-height: 1.8;
  white-space: pre-line;
}

.save-btn {
  margin-top: 12rpx;
}

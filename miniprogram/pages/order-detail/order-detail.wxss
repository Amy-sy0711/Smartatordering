.status-card {
  background: linear-gradient(135deg, #ff8c42, #e85d04);
  color: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.status-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-text {
  font-size: 38rpx;
  font-weight: 600;
}

.status-tag {
  background: rgba(255, 255, 255, 0.24);
  color: #ffffff;
}

.timeline {
  display: flex;
  margin-top: 30rpx;
  overflow: hidden;
}

.step-item {
  flex: 1;
  text-align: center;
  position: relative;
}

.step-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
  margin: 0 auto 10rpx;
}

.step-dot--done {
  background: #ffffff;
}

.step-dot--current {
  width: 20rpx;
  height: 20rpx;
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(255, 255, 255, 0.35);
}

.step-label {
  font-size: 20rpx;
  opacity: 0.6;
}

.step-label--done {
  opacity: 1;
}

.refund-tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  background: rgba(0, 0, 0, 0.14);
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
}

.item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.item-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #f2f4f8;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.item-main {
  flex: 1;
}

.item-name {
  font-size: 28rpx;
}

.item-spec {
  font-size: 22rpx;
  color: #8b93a1;
  margin-top: 4rpx;
}

.item-delta {
  color: #e85d04;
}

.item-qty {
  width: 90rpx;
  text-align: center;
  color: #8b93a1;
  font-size: 24rpx;
}

.item-total {
  width: 140rpx;
  text-align: right;
  font-size: 26rpx;
}

.total {
  font-size: 32rpx;
  font-weight: 600;
  color: #e85d04;
}

.copy {
  font-size: 20rpx;
  color: #e85d04;
  margin-left: 8rpx;
}

.history {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
}

.history-label {
  font-size: 24rpx;
  color: #5c6472;
}

.actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 24rpx;
  background: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.action-btn {
  margin-left: 16rpx;
  min-width: 180rpx;
  height: 80rpx;
  border-radius: 999rpx;
}

.page {
  padding-bottom: 180rpx;
}

.loading {
  padding: 100rpx 0;
  text-align: center;
  color: #8b93a1;
}

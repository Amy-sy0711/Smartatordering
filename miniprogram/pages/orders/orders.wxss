.order {
  padding: 24rpx;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  font-size: 26rpx;
  font-weight: 600;
}

/* 待取餐取餐码：列表里最醒目的信息 */
.pickup-code {
  display: flex;
  align-items: baseline;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fff4e8;
}

.pickup-code-label {
  font-size: 22rpx;
  color: #a15c17;
  margin-right: 12rpx;
}

.pickup-code-value {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #e85d04;
}

.pickup-code-tip {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #a15c17;
}

.pickup-code--missing {
  background: #f4f4f5;
}

.pickup-code--missing .pickup-code-label,
.pickup-code--missing .pickup-code-tip {
  color: #6b7280;
}

.order-time {
  margin-left: 12rpx;
}

.order-body {
  padding: 18rpx 0;
}

.order-summary {
  font-size: 26rpx;
  line-height: 1.6;
}

.order-meta {
  margin-top: 8rpx;
}

.order-total {
  font-size: 26rpx;
  margin-top: 10rpx;
  color: #5c6472;
}

.strong {
  color: #e85d04;
  font-weight: 600;
  font-size: 30rpx;
}

.order-remark {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8b93a1;
}

.order-foot {
  display: flex;
  justify-content: flex-end;
  padding-top: 16rpx;
  border-top: 1rpx solid #f2f4f8;
}

.order-foot .btn {
  margin-left: 16rpx;
}

.empty-btn {
  margin-top: 28rpx;
  width: 220rpx;
}

.loading {
  padding: 100rpx 0;
  text-align: center;
  color: #8b93a1;
}

.more {
  text-align: center;
  padding: 20rpx 0 60rpx;
}
